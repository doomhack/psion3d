public _ddaWalk3:
	push  ax
	mov   di,ax
	mov   si,[di]
	mov   ax,[di][2]
	mov   cx,[di][4]
	mov   dx,[di][6]
	mov   di,[di][8]
ddaQ3:
	cmp   ax,cx
	jae   ddaQ3y
	add   ax,dx
	dec   si
	dec   si
	mov   bx,[si]
	test  bh,20H
	jne   ddaQ3sx
	and   bx,9000H
	cmp   bx,1000H
	jne   ddaQ3
ddaQ3sx:
	xor   bx,bx
	jmp   near ddaStop
ddaQ3y:
	add   cx,di
