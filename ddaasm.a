public _ddaWalk2:
	push  ax
	mov   di,ax
	mov   si,[di]
	mov   ax,[di][2]
	mov   cx,[di][4]
	mov   dx,[di][6]
	mov   di,[di][8]
ddaQ2:
	cmp   ax,cx
	jae   ddaQ2y
	add   ax,dx
	inc   si
	inc   si
	mov   bx,[si]
	test  bh,20H
	jne   ddaQ2sx
	and   bx,9000H
	cmp   bx,1000H
	jne   ddaQ2
ddaQ2sx:
	xor   bx,bx
	jmp   near ddaStop
ddaQ2y:
	add   cx,di
	sub   si,128
	mov   bx,[si]
	test  bh,20H
