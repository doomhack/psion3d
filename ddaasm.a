module ddaasm

segment _TEXT(CODE,48H)

public _ddaWalk0:
	push  ax
	mov   di,ax
	mov   si,[di]
	mov   ax,[di][2]
	mov   cx,[di][4]
	mov   dx,[di][6]
	mov   di,[di][8]
ddaQ0:
	cmp   ax,cx
	jae   ddaQ0y
	add   ax,dx
	inc   si
	inc   si
	mov   bx,[si]
	test  bh,20H
	jne   ddaQ0sx
	and   bx,9000H
	cmp   bx,1000H
	jne   ddaQ0
ddaQ0sx:
	xor   bx,bx
	jmp   near ddaStop
ddaQ0y:
	add   cx,di
	add   si,128
	mov   bx,[si]
	test  bh,20H
	jne   ddaQ0sy
	and   bx,9000H
	cmp   bx,1000H
	jne   ddaQ0
ddaQ0sy:
	mov   bx,1
	jmp   near ddaStop

